{
  "name": "open-tax",
  "version": "0.1.0",
  "description": "Loader and validator for Open-Tax jurisdiction packs: effective-dated tax treatments, policy diffs, and filing dictionaries.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas/regime.schema.json": "./schemas/regime.schema.json",
    "./schemas/policy-diff.schema.json": "./schemas/policy-diff.schema.json",
    "./schemas/dictionary-entry.schema.json": "./schemas/dictionary-entry.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glc-works/open-tax.git",
    "directory": "packages/open-tax"
  },
  "bugs": {
    "url": "https://github.com/glc-works/open-tax/issues"
  },
  "homepage": "https://github.com/glc-works/open-tax#readme",
  "keywords": [
    "tax",
    "vat",
    "gst",
    "withholding",
    "jurisdiction",
    "json-schema",
    "open-tax"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-schemas.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate": "node --import tsx src/cli.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
